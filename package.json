                    "test:coverage":  "jest --coverage",
                    "lint":  "eslint src/**/*.js",
                    "seed":  "node src/seeders/seed.js",
                    "docker:dev":  "docker-compose up -d",
                    "test:unit":  "vitest run tests/unit",
                    "test:integration":  "vitest run tests/integration"
                },
