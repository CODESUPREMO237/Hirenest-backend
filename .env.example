# ============================================================================
# Backend Environment Variables Template
# Copy this file to .env and fill in your actual values
# ============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ============================================================================
# MongoDB Configuration
# ============================================================================
# Local: mongodb://localhost:27017/yourdbname
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGO_URI=mongodb://localhost:27017/Jobconnect

# ============================================================================
# Firebase Configuration
# Get these from Firebase Console > Project Settings > Service Accounts
# ============================================================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com

# ============================================================================
# JWT Configuration
# Generate secure random strings: https://www.grc.com/passwords.htm
# ============================================================================
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRE=30d

# ============================================================================
# CORS Configuration
# ============================================================================
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://192.168.1.XXX:3000,http://10.0.2.2:3000

# ============================================================================
# File Upload Configuration
# ============================================================================
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# ============================================================================
# Cloudinary Configuration (Optional - for cloud storage)
# Get from: https://cloudinary.com/console
# ============================================================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================================================
# Email Configuration (Resend API)
# Get from: https://resend.com/api-keys
# ============================================================================
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=onboarding@resend.dev

# ============================================================================
# MeSomb Configuration (Cameroon Mobile Money Payment Gateway)
# Get from: https://mesomb.hachther.com/
# ============================================================================
MESOMB_APPLICATION_KEY=your-application-key
MESOMB_ACCESS_KEY=your-access-key
MESOMB_SECRET_KEY=your-secret-key
MESOMB_CURRENCY=XAF

# ============================================================================
# Redis Configuration (Optional - for caching and sessions)
# ============================================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# API Rate Limiting per user role
RATE_LIMIT_GUEST=50
RATE_LIMIT_JOBSEEKER=200
RATE_LIMIT_EMPLOYER=200
RATE_LIMIT_ADMIN=1000

# ============================================================================
# Socket.IO Configuration
# ============================================================================
SOCKET_CORS_ORIGIN=http://localhost:3000,http://192.168.1.XXX:3000

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# ============================================================================
# Security
# ============================================================================
BCRYPT_ROUNDS=10
SESSION_SECRET=your-session-secret-min-32-chars

# ============================================================================
# Guest User Limitations
# ============================================================================
GUEST_JOB_VIEW_LIMIT=10
GUEST_PRODUCT_VIEW_LIMIT=20
GUEST_SEARCH_LIMIT=5

# ============================================================================
# Marketplace Configuration
# ============================================================================
COMMISSION_RATE=0.05
MIN_ORDER_AMOUNT=1
MAX_ORDER_AMOUNT=10000

# ============================================================================
# Pagination
# ============================================================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ============================================================================
# Timezone
# ============================================================================
TZ=UTC

# ============================================================================
# OAuth Configuration
# ============================================================================

# GitHub OAuth
# Get from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Microsoft OAuth
# Get from: https://portal.azure.com/ > App Registrations
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# Twitter OAuth 2.0 (Optional)
# Get from: https://developer.twitter.com/en/portal/dashboard
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret

# LinkedIn OAuth (Optional)
# Get from: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret